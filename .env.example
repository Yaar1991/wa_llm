# Host ports (uncommon 473xx range to avoid clashes). If you change one, also
# update the matching URL below (WHATSAPP_HOST / DB_URI / PORT).
WEB_SERVER_HOST_PORT=47320
WHATSAPP_HOST_PORT=47321
POSTGRES_HOST_PORT=47322
# Port the app listens on when run on the host (Docker uses 8000 internally)
PORT=47320

WHATSAPP_HOST=http://localhost:47321
WHATSAPP_BASIC_AUTH_USER=admin
WHATSAPP_BASIC_AUTH_PASSWORD=admin
# Inside Docker, Compose overrides WHATSAPP_HOST and DB_URI with internal addresses.
DB_URI=postgresql+asyncpg://user:password@localhost:47322/postgres
LOG_LEVEL=INFO

# Local LLM (Ollama running natively on the Mac). Docker Compose overrides
# OLLAMA_BASE_URL to http://host.docker.internal:11434 for the web-server.
OLLAMA_BASE_URL=http://localhost:11434
# Created from ollama/Modelfile (see README)
OLLAMA_MODEL=wa-summarizer
LLM_DISABLE_THINKING=true

# Scheduled summaries for enabled groups (crontab format; empty disables)
SUMMARY_CRON=0 21 * * *
SUMMARY_TIMEZONE=Asia/Jerusalem
SUMMARY_MIN_MESSAGES=15
